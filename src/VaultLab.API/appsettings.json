{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMq": {
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 10000,
    "Exchanges": {
      "Document": "vaultlab-document"
    },
    "Queues": {
      "DocumentProcessing": "document-processing",
      "DocumentRetry": "document-processing-retry",
      "DocumentDeadLetter": "document-processing-dead-letter"
    },
    "RoutingKeys": {
      "DocumentUploaded": "document.uploaded",
      "DocumentProcessingRetry": "document.processing.retry",
      "DocumentProcessingDeadLetter": "document.processing.deadletter"
    }
  },
  "AllowedHosts": "*"
}
